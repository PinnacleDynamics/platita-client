{
  "name": "platita",
  "displayName": "Platita \u2014 get paid while your AI thinks",
  "description": "Sponsored line in your editor's status bar while your AI codes \u2014 Copilot, ChatGPT, Claude, Gemini, any assistant. 70% of ad revenue paid to you in USDT (TRC-20). No KYC.",
  "version": "0.3.1",
  "publisher": "platita",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "copilot",
    "chatgpt",
    "claude",
    "claude code",
    "cursor",
    "windsurf",
    "gemini",
    "ai",
    "earn",
    "usdt",
    "crypto",
    "tron",
    "statusline"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PinnacleDynamics/platita-client"
  },
  "homepage": "https://platita.lat",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "platita.connect",
        "title": "Platita: Connect account"
      },
      {
        "command": "platita.openPanel",
        "title": "Platita: Open my panel (platita.lat)"
      },
      {
        "command": "platita.disconnect",
        "title": "Platita: Disconnect"
      }
    ],
    "configuration": {
      "title": "Platita",
      "properties": {
        "platita.adAnimation": {
          "type": "boolean",
          "default": true,
          "description": "Slide the sponsored line in (marquee) when it changes. Turn off for a static line."
        }
      }
    }
  }
}